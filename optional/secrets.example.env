# ============================================================================
# Secrets template. Copy to `.env`, fill in, and NEVER commit the real file.
#   cp deploy/secrets.example.env .env
# `.gitignore` already excludes `.env` and `state*.json`.
#
# In CI, set these as repository SECRETS (GitHub: Settings → Secrets and
# variables → Actions). On Cloudflare, use `wrangler secret put`.
# Never paste a token into a commit message, an issue, or a screenshot.
# ============================================================================

# --- Telegram (RECOMMENDED public channel) ---------------------------------
# 1. Message @BotFather on Telegram → /newbot → copy the token.
# 2. Create a *CHANNEL* (not a group) — subscribers can't reply-spam the feed.
#    Make it public so people can find and join it.
# 3. Add your bot as an Administrator with "Post messages" rights.
# 4. Get the chat id: post anything in the channel, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    and read `chat.id`. Public channels are "@yourchannelname";
#    private channels are a negative number like "-1001234567890".
TELEGRAM_BOT_TOKEN=1234567890:AAExampleOnlyReplaceMe
TELEGRAM_CHAT_ID=@anak_krakatau_monitor

# --- ntfy.sh (PERSONAL /OPS ONLY — see publish.py docstring) -----------------
# A bare topic is world-writable: anyone who guesses the name can post
# "LEVEL IV AWAS" to your subscribers. Two ways to be safe:
#   (a) long random topic name, or
#   (b) BEST: free ntfy.sh account → create an ACCESS TOKEN with publish-only
#       rights on the topic → set NTFY_TOKEN. Readers can then subscribe
#       without being able to spoof you.
# Free tier is ~250 messages/day per visitor — enough for ops, not broadcast.
NTFY_URL=https://ntfy.sh/ak-REPLACE-WITH-64-RANDOM-CHARS
NTFY_TOKEN=tk_AgExamplePublishOnlyToken

# --- Supabase (archive + dedupe + heartbeat) --------------------------------
# Project Settings → API.
#   SUPABASE_SERVICE_KEY = `service_role` — BYPASSES ROW LEVEL SECURITY.
#   It must only ever exist in CI secrets or a Worker secret. If it reaches a
#   browser bundle, anyone can rewrite your public data. Rotate it if it leaks.
#   Lower-risk alternative: create a SECURITY DEFINER RPC that inserts into
#   readings/events/heartbeat and grant it to `authenticated`, then use the
#   anon key here instead. Smaller blast radius for the same job.
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciExampleServiceRoleKeyReplaceMe

# --- optional: generic webhook (Slack / Discord / Matrix) -------------------
WEBHOOK_URL=

# --- optional: NASA FIRMS (Aqua/Terra MODIS, Suomi NPP + NOAA-20 VIIRS) -----
# Free key: https://firms.modaps.eosdis.nasa.gov/api/
# Thermal hotspots only — confirms an eruption is ongoing, cannot see ash.
FIRMS_MAP_KEY=
